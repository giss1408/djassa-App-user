<?xml version="1.0" encoding="utf-8"?>
<!-- The Djassa mark with no tile behind it: the background layer is
     transparent, so the launcher shows the mark on the wallpaper. The mark
     sits inside the launcher's safe circle, so its crop (circle, squircle...)
     cuts nothing. Generated from the site's .brand-mark. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@android:color/transparent" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
